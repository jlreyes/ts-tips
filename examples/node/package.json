{
  "name": "standards-node-example",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint --deny-warnings src",
    "format:check": "oxfmt --check --config oxfmt.config.mjs src",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run format:check && npm run typecheck"
  },
  "devDependencies": {
    "@jlreyes/typescript-standards": "0.1.0",
    "@types/node": "24.13.3",
    "oxfmt": "0.56.0",
    "oxlint": "1.71.0",
    "typescript": "6.0.3"
  }
}
