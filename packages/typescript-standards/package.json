{
  "name": "@jlreyes/typescript-standards",
  "version": "0.2.0",
  "description": "Shared TypeScript, Oxlint and Oxfmt standards with repository-owned overrides",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlreyes/ts-tips.git",
    "directory": "packages/typescript-standards"
  },
  "files": [
    "oxlint.json",
    "oxfmt.mjs",
    "tsconfig.strict.json",
    "tsconfig.node.json",
    "README.md",
    "LICENSE",
    "oxfmt.d.mts"
  ],
  "type": "module",
  "exports": {
    "./oxlint.json": "./oxlint.json",
    "./oxfmt": {
      "types": "./oxfmt.d.mts",
      "default": "./oxfmt.mjs"
    },
    "./tsconfig.strict.json": "./tsconfig.strict.json",
    "./tsconfig.node.json": "./tsconfig.node.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24 <25 || >=26 <27"
  }
}
